<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="shortcut icon" href="favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <main>
        <!-- Título principal da página -->
        <h1>Essa é a home da minha página!</h1>
        <!-- Exibe o nome e a idade do usuário -->
        <p>O nome do usuário é {{user.name}}, a idade é {{user.age}}</p>
        <!-- Exibe o conteúdo da variável palavra -->
        <h2>{{Palavra}}</h2>
        <!-- Verifica se o usuário está autenticado -->
        {{#if auth}}
        <!-- Aparece quando o usuário está autenticado -->
        <p>Você está autenticado, pode acessar o <a href="/dashboard">link</a></p>
        {{else}}
        <!-- Aparece quando o usuário não está autenticado -->
        <p>Você não está autenticado</p>
        {{/if}}
    </main>
</body>
</html>